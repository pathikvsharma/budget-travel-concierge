# ============================================================================
# TripPilot — Budget-Smart Travel Concierge Agent
# Copy this file to `.env` for local development (`cp .env.example .env`).
# NEVER commit `.env` or real credentials to version control.
# ============================================================================

# --- Option A: Gemini Developer API (Local Quickstart / ADK Web) ------------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Option B: Vertex AI + Application Default Credentials (Production) -----
# Set GOOGLE_GENAI_USE_VERTEXAI=TRUE and authenticate with `gcloud auth application-default login`
# or attach a least-privilege Service Account on Cloud Run / Vertex AI Agent Engine.
# Gemini 3.x models are served from the `global` Vertex AI endpoint.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# Optional: force the model endpoint when a deploy tool sets GOOGLE_CLOUD_LOCATION
# to a regional value (e.g. `adk deploy cloud_run --region=us-central1`).
# VERTEX_AI_LOCATION=global

# Optional: Load GOOGLE_API_KEY from Google Cloud Secret Manager instead of env
# GCP_SECRET_MANAGER_API_KEY_RESOURCE=projects/your-gcp-project-id/secrets/gemini-api-key/versions/latest

# --- Strategic Model Routing Tiers ------------------------------------------
FAST_MODEL=gemini-3.5-flash
REASONING_MODEL=gemini-3.1-pro-preview

# --- Persistent Session & Catalog Storage -----------------------------------
# Defaults to local SQLite files inside ./data/ (auto-created, gitignored).
TRAVEL_DATA_DIR=./data
# Optional override (e.g. Cloud SQL Postgres via asyncpg in production):
# TRAVEL_SESSION_DB_URL=sqlite+aiosqlite:///./data/trippilot_sessions.db

# --- Context & Compaction ---------------------------------------------------
COMPACTION_INTERVAL=6
COMPACTION_OVERLAP_SIZE=2
MAX_CONTEXT_TURNS=16

# --- Guardrails & Human-in-the-Loop Policy ----------------------------------
HITL_BOOKING_THRESHOLD_USD=250.0
MAX_SINGLE_BOOKING_USD=15000.0

# --- Observability & Distributed Tracing ------------------------------------
LOG_LEVEL=INFO
SERVICE_NAME=trippilot-travel-concierge
ENABLE_CLOUD_TRACE=FALSE
